// Database схемасы (PostgreSQL). Raw деректер, нәтиже және түзетулер бөлек сақталады.
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  admin
  designer
  viewer
}

enum CalcStatus {
  ok
  needs_review
  ask_designer
  corrected
}

enum WeekStatus {
  open
  sent
  locked
}

model User {
  id         String    @id @default(uuid())
  name       String
  role       Role
  telegramId BigInt?   @unique
  linkCode   String?   @unique // бір реттік тіркеу коды
  linkCodeAt DateTime?
  active     Boolean   @default(true)
  designer   Designer?
  createdAt  DateTime  @default(now())
}

model Designer {
  id            String        @id @default(uuid())
  userId        String        @unique
  user          User          @relation(fields: [userId], references: [id])
  yougileUserId String        @unique
  yougileName   String
  shortName     String
  excelName     String
  active        Boolean       @default(true)
  calculations  Calculation[]
  weeklyReports WeeklyReport[]
}

/// YouGile колонкасы → пән/аккаунт
model Location {
  id              String  @id @default(uuid())
  yougileColumnId String  @unique
  project         String
  board           String
  column          String
  subjectId       String?
  subject         Subject? @relation(fields: [subjectId], references: [id])
  tasks           Task[]
}

model Subject {
  id        String     @id @default(uuid())
  name      String     @unique // Excel атауы: «ДЖТ», «IELTS»
  sheet     String     // ПӘН АКК / ИНСТА АКК / ӨЗГЕ
  locations Location[]
}

model WorkType {
  id     String @id @default(uuid())
  name   String @unique
  points Float? // болашақ жалақы есебі үшін
  order  Int    @default(0)
}

model Rule {
  id          String        @id @default(uuid())
  code        String        @unique
  level       Int
  description String
  when        Json
  outputs     Json
  reviewReason String?
  active      Boolean       @default(true)
  version     Int           @default(1)
  updatedBy   String?
  updatedAt   DateTime      @updatedAt
  versions    RuleVersion[]
}

model RuleVersion {
  id        String   @id @default(uuid())
  ruleId    String
  rule      Rule     @relation(fields: [ruleId], references: [id])
  version   Int
  snapshot  Json
  createdBy String?
  createdAt DateTime @default(now())

  @@unique([ruleId, version])
}

model Setting {
  key   String @id // correction_words, allowed_exts, month1, many_files_limit
  value Json
}

/// YouGile тапсырмасының raw көшірмесі
model Task {
  id             String        @id @default(uuid())
  yougileId      String        @unique
  code           String
  title          String
  locationId     String?
  location       Location?     @relation(fields: [locationId], references: [id])
  assigned       String[]
  completed      Boolean
  completedAt    DateTime?
  deadlineAt     DateTime?
  createdAtYg    DateTime?
  raw            Json
  contentHash    String
  reopenedCount  Int           @default(0)
  lastSyncedAt   DateTime      @default(now())
  files          TaskFile[]
  calculations   Calculation[]
}

model TaskFile {
  id              String   @id @default(uuid())
  taskId          String
  task            Task     @relation(fields: [taskId], references: [id])
  uuid            String
  name            String
  ext             String
  messageId       BigInt
  uploadedBy      String
  uploadedAt      DateTime
  counted         Boolean
  askDesigner     Boolean  @default(false)
  exclusionReason String?

  @@unique([taskId, uuid])
}

model Week {
  id            String         @id @default(uuid())
  monday        DateTime       @unique @db.Date
  startAt       DateTime
  endAt         DateTime
  label         String
  status        WeekStatus     @default(open)
  sentAt        DateTime?
  calculations  Calculation[]
  weeklyReports WeeklyReport[]
}

model Calculation {
  id           String       @id @default(uuid())
  taskId       String
  task         Task         @relation(fields: [taskId], references: [id])
  designerId   String
  designer     Designer     @relation(fields: [designerId], references: [id])
  weekId       String
  week         Week         @relation(fields: [weekId], references: [id])
  isSupplement Boolean      @default(false) // қайта ашылған тапсырманың қосымшасы
  fileCount    Int
  ruleCode     String?
  ruleVersion  Int?
  status       CalcStatus
  reasons      String[]
  warnings     String[]
  items        Json         // {"Пост":1,"Карусель":16}
  trace        Json
  corrections  Correction[]
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@unique([taskId, designerId, weekId, isSupplement])
}

model Correction {
  id            String      @id @default(uuid())
  calculationId String
  calculation   Calculation @relation(fields: [calculationId], references: [id])
  oldItems      Json
  newItems      Json
  reason        String
  madeBy        String
  revertedBy    String?
  revertedAt    DateTime?
  createdAt     DateTime    @default(now())
}

model WeeklyReport {
  id          String    @id @default(uuid())
  weekId      String
  week        Week      @relation(fields: [weekId], references: [id])
  designerId  String
  designer    Designer  @relation(fields: [designerId], references: [id])
  status      String    @default("sent") // sent / confirmed / disputed
  sentAt      DateTime?
  confirmedAt DateTime?

  @@unique([weekId, designerId])
}

model SyncRun {
  id           String    @id @default(uuid())
  startedAt    DateTime  @default(now())
  finishedAt   DateTime?
  requests     Int       @default(0)
  tasksNew     Int       @default(0)
  tasksChanged Int       @default(0)
  error        String?
}

model AuditLog {
  id       String   @id @default(uuid())
  actor    String
  action   String
  entity   String
  entityId String
  before   Json?
  after    Json?
  at       DateTime @default(now())
}
